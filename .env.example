# ScamShield backend configuration.
#   cp .env.example .env      (never commit .env; it is git-ignored)
# npm scripts (dev, start, db:*, admin:promote) load .env automatically when it exists.
# Every variable is SERVER-ONLY. None of it belongs in frontend code.
# Empty values are treated as "not set". Validation lives in server/config.ts; on an invalid
# value the server refuses to start and names the variable (never its value).
#
# For local development every line below is OPTIONAL: the defaults just work.
# For production you MUST set: NODE_ENV=production, DATABASE_URL, MAIL_TRANSPORT=smtp,
# SMTP_URL, PUBLIC_APP_URL (https), and CORS_ORIGINS if the frontend is on another origin.
#
# No API keys are needed: ScamShield uses its own ML model, run locally.

# --- Server -----------------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=127.0.0.1                  # use 0.0.0.0 in a container / on a server
PORT=3000
PUBLIC_APP_URL=http://127.0.0.1:3000   # base URL for links in emails; production: required, must be https://
CORS_ORIGINS=                   # comma-separated frontend origins (development defaults to localhost and 127.0.0.1 on ports 3000 and 4173; production defaults to none)
SERVE_FRONTEND=true             # serve the analyzer and password-reset page from the API origin
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# --- Database ---------------------------------------------------------------------
# Leave DATABASE_URL empty in development to use the embedded PGlite database in .data/pglite.
# Production REQUIRES PostgreSQL. Format: postgres://USER:PASSWORD@HOST:5432/DBNAME  (SECRET)
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite  # PGlite only
DB_AUTO_MIGRATE=false           # PGlite always auto-migrates; for PostgreSQL run `npm run db:migrate`

# --- Authentication ---------------------------------------------------------------
# No session/JWT secret exists: sign-in tokens are random 256-bit values stored only as SHA-256 hashes.
REQUIRE_EMAIL_VERIFICATION=true # keep true in production
SESSION_TTL_HOURS=168           # 1-2160 (7 days by default)

# --- Email / SMTP -----------------------------------------------------------------
MAIL_TRANSPORT=console          # console (dev: prints emails to the terminal) | smtp (required in production) | memory (tests)
SMTP_URL=                       # SECRET. Required when MAIL_TRANSPORT=smtp. e.g. smtps://USER:PASSWORD@smtp.example.com:465
                                # (URL-encode special characters in the password, e.g. @ -> %40)
MAIL_FROM=ScamShield <no-reply@scamshield.local>   # production: an address your SMTP provider lets you send from

# --- Machine Learning (ScamShield's own model; local inference, no external AI) -------------
ML_ENABLED=true                 # false = rule-based checks only
# ML_MODEL_DIR=                 # default: ml/artifacts/scamshield-text-v1.0.0 (only use artifacts you trained)
ML_ENGINE=worker                # worker (thread pool with timeout + heap limit) | in-process
ML_WORKERS=1                    # inference threads, 1-8
ML_TIMEOUT_MS=1500              # 100-10000; on timeout the worker is replaced and rules are used
ML_MAX_QUEUE=64                 # 1-1000 pending inferences before requests fall back to rules
ML_WORKER_MAX_HEAP_MB=256       # 64-2048, V8 heap limit per worker

# --- OCR (screenshot analysis, optional) -------------------------------------------
OCR_ENABLED=false               # true downloads Tesseract language data from its CDN on first use (free, no key)
OCR_LANGS=eng+ara
OCR_CACHE_DIR=.cache/tesseract
OCR_TIMEOUT_MS=30000            # 1000-120000
UPLOAD_MAX_BYTES=5242880        # 1024-10485760 (5 MB default)

# --- Security ---------------------------------------------------------------------
TRUST_PROXY=false               # true ONLY behind a trusted reverse proxy (affects client IP for rate limits)
RATE_LIMIT_ENABLED=true         # in-memory, per process (see docs/SECURITY.md)

# --- Optional integrations ----------------------------------------------------------
# None. The removed Anthropic integration's AI_PROVIDER, ANTHROPIC_API_KEY and AI_MODEL are
# no longer read; delete them from your .env (the server logs a warning, by name only, if present).

# --- ML pipeline tests only (not read by the server) ---------------------------------
# SCAMSHIELD_SLOW=1 npm run ml:test   # also retrains from prepared data and checks the model hash
