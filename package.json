{
  "name": "scam-shield",
  "version": "0.1.0",
  "private": true,
  "description": "ScamShield: explainable scam detection for messages, links, and emails, using its own ML classifier plus rule-based checks.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/scripts/seed.ts",
    "admin:promote": "tsx --env-file-if-exists=.env server/scripts/promote-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "ml:setup": "python3 -m venv ml/.venv && ml/.venv/bin/pip install -r ml/requirements.txt",
    "ml:download": "cd ml && .venv/bin/python -E -s -m scamshield_ml.download",
    "ml:prepare": "cd ml && .venv/bin/python -E -s -m scamshield_ml.prepare",
    "ml:train": "cd ml && .venv/bin/python -E -s -m scamshield_ml.train",
    "ml:evaluate-hybrid": "tsx server/scripts/evaluate-hybrid.ts",
    "ml:test": "cd ml && .venv/bin/python -E -s -m pytest -q tests",
    "ml:pipeline": "npm run ml:download && npm run ml:prepare && npm run ml:train && npm run ml:evaluate-hybrid"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
