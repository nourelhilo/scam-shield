# ScamShield backend configuration. Copy to .env (never commit .env).
# npm scripts load .env automatically when it exists.
# Everything below is SERVER-ONLY. None of it belongs in frontend code.

# --- Server -----------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=3000
PUBLIC_APP_URL=http://127.0.0.1:3000   # used to build links in emails
TRUST_PROXY=false               # true only behind a trusted reverse proxy (affects client IP for rate limits)
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173   # comma-separated frontend origins
SERVE_FRONTEND=true             # serve index.html/styles.css/checker.js from the API origin (dev convenience)
# LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty in development to use the embedded PGlite database in .data/pglite.
# Production REQUIRES a real PostgreSQL URL.
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite
DB_AUTO_MIGRATE=false           # PGlite always auto-migrates; for PostgreSQL run `npm run db:migrate`

# --- ScamShield ML classifier ---------------------------------------------------
# ScamShield uses its OWN trained model (ml/artifacts/), run locally. No external AI/LLM
# service is called and no API key is needed. The old AI_PROVIDER / ANTHROPIC_API_KEY /
# AI_MODEL settings are ignored (a warning is logged if they are still set).
ML_ENABLED=true                 # false = rule-based checks only
# ML_MODEL_DIR=                 # default: ml/artifacts/scamshield-text-v1.0.0 (only use artifacts you trained)
ML_ENGINE=worker                # worker (default: thread pool with timeouts + heap limit) | in-process
ML_WORKERS=1                    # inference threads (1-8)
ML_TIMEOUT_MS=1500              # per request; on timeout the worker is replaced and rules are used
ML_MAX_QUEUE=64                 # pending inferences before requests fall back to rules (queue_full)
ML_WORKER_MAX_HEAP_MB=256       # V8 heap limit per worker

# --- Accounts & email ----------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=true
SESSION_TTL_HOURS=168
MAIL_TRANSPORT=console          # console (dev: prints emails to the terminal) | smtp | memory (tests)
SMTP_URL=                       # e.g. smtps://user:pass@smtp.example.com:465 (required when MAIL_TRANSPORT=smtp)
MAIL_FROM=ScamShield <no-reply@scamshield.local>

# --- Screenshot OCR (optional) ---------------------------------------------------
OCR_ENABLED=false               # true downloads Tesseract language data from its CDN on first use
OCR_LANGS=eng+ara
OCR_CACHE_DIR=.cache/tesseract
OCR_TIMEOUT_MS=30000
UPLOAD_MAX_BYTES=5242880        # 5 MB

# --- Abuse protection ----------------------------------------------------------
RATE_LIMIT_ENABLED=true         # in-memory, per process (see docs/SECURITY.md)
